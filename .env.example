# Copy to .env (git-ignored). docker compose reads .env automatically.

# Host user/group mapped into the container (docker-compose.yml: user "${UID:-1000}:${GID:-1000}").
# Bash does not export UID/GID, so set them here. Check yours with: id -u; id -g
UID=1000
GID=1000

# Optional: raw data outside the repository (an external disk, a shared server).
# Mounted read-only at /data and at /workspace/data/raw. Default: ./data/raw
# HOST_DATA_DIR=/absolute/path/to/raw

# Optional, GPU machines only: set once here so that every plain `docker compose ...`
# (build, up, the rebuild after uv add) keeps the NVIDIA GPU override. Passing -f to
# one command is not enough: the next plain `docker compose up -d` recreates the
# container without the GPU, with no error.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Optional: Compose names the image and container after this directory. Set this
# when two checkouts share a directory name.
# COMPOSE_PROJECT_NAME=my-project
