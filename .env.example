# Copy to .env (git-ignored). docker compose reads .env automatically.

# Host user/group mapped into the container (docker-compose.yml: user "${UID:-1000}:${GID:-1000}").
# Bash does not export UID/GID, so set them here. Check yours with: id -u; id -g
UID=1000
GID=1000

# Optional: raw-data location for host-side runs of config.py.
# Inside Docker, docker-compose.yml sets DATA_ROOT=/data regardless.
# DATA_ROOT=/absolute/path/to/data/raw

# Optional: host port forwarded to Jupyter (container port 8888).
# Change if 8889 is taken by another project.
# HOST_JUPYTER_PORT=8889
